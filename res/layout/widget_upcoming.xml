<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DUE NEXT" android:textColor="@color/w_accent" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/>
        <TextView android:id="@+id/week" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end" android:textColor="@color/w_fg2" android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="9dp">
        <ImageView android:id="@+id/dot0" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/w_dot"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/name0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/w_fg" android:textSize="14sp" android:fontFamily="sans-serif-medium"
                android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/when0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/w_fg2" android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/amt0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/w_fg" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="9dp">
        <ImageView android:id="@+id/dot1" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/w_dot"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/name1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/w_fg" android:textSize="14sp" android:fontFamily="sans-serif-medium"
                android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/when1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/w_fg2" android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/amt1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/w_fg" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="9dp">
        <ImageView android:id="@+id/dot2" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/w_dot"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/name2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/w_fg" android:textSize="14sp" android:fontFamily="sans-serif-medium"
                android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/when2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/w_fg2" android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/amt2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/w_fg" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="9dp">
        <ImageView android:id="@+id/dot3" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/w_dot"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/name3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/w_fg" android:textSize="14sp" android:fontFamily="sans-serif-medium"
                android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/when3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/w_fg2" android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/amt3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/w_fg" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="9dp">
        <ImageView android:id="@+id/dot4" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/w_dot"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/name4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/w_fg" android:textSize="14sp" android:fontFamily="sans-serif-medium"
                android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/when4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/w_fg2" android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/amt4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/w_fg" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
        android:textColor="@color/w_fg2" android:textSize="14sp" android:visibility="gone"/>
</LinearLayout>
