<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg" android:padding="14dp">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="THIS MONTH" android:textColor="@color/w_accent" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/>
    <TextView android:id="@+id/lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="Left to spend" android:textColor="@color/w_fg2" android:textSize="12sp"/>
    <TextView android:id="@+id/left" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/w_fg" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:singleLine="true"/>
    <LinearLayout android:id="@+id/lines" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Income" android:textColor="@color/w_fg2" android:textSize="11sp"/>
            <TextView android:id="@+id/income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bills" android:textColor="@color/w_fg2" android:textSize="11sp"/>
            <TextView android:id="@+id/bills" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wealth" android:textColor="@color/w_fg2" android:textSize="11sp"/>
            <TextView android:id="@+id/save" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="10dp" android:max="100" android:progressDrawable="@drawable/w_bar"/>
    <TextView android:id="@+id/paid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:textColor="@color/w_fg2" android:textSize="12sp" android:singleLine="true"/>
</LinearLayout>
